{
  "name": "@daydrift/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "astro build && node ../../tools/sync-dist.mjs docs",
    "preview": "astro preview",
    "generate:api": "tsx tools/generate_api_reference.ts",
    "check:api": "tsx tools/generate_api_reference.ts --check",
    "typecheck": "astro check",
    "lint": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.32.1",
    "@daydrift/content": "workspace:*",
    "@daydrift/ui": "workspace:*",
    "astro": "^5.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}

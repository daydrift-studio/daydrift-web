---
interface Props {
  currentTab?: "home" | "download" | "releases" | "docs" | "mods" | "about" | "credits";
  locale?: "zh-CN" | "en";
}

const { currentTab = "home", locale = "zh-CN" } = Astro.props;

const isZh = locale === "zh-CN";
---

<div id="site-progress-bar" aria-hidden="true"></div>

<header class="site-header">
  <div class="container header-container">
    <a href="/" class="brand-link" aria-label="度日：Daydrift 首页">
      <div class="brand-badge">
        <img src="/icon.svg" alt="Daydrift Icon" class="brand-logo-img" width="24" height="24" />
        <span class="brand-name">度日</span>
        <span class="brand-sub">DAYDRIFT</span>
      </div>
    </a>

    <nav class="nav-links" aria-label="主导航">
      <a href="/download" class:list={["nav-item", { active: currentTab === "download" }]}>
        {isZh ? "下载" : "Download"}
      </a>
      <a href="/releases" class:list={["nav-item", { active: currentTab === "releases" }]}>
        {isZh ? "更新历史" : "Releases"}
      </a>
      <a href="https://daydrift-docs.blym.top" class:list={["nav-item", { active: currentTab === "docs" }]}>
        {isZh ? "文档" : "Docs"}
      </a>
      <a href="https://daydrift-mods.blym.top" class:list={["nav-item", { active: currentTab === "mods" }]}>
        {isZh ? "Mod" : "Mods"}
      </a>
      <a href="/about" class:list={["nav-item", { active: currentTab === "about" }]}>
        {isZh ? "关于" : "About"}
      </a>
      <a href="/credits" class:list={["nav-item", { active: currentTab === "credits" }]}>
        {isZh ? "鸣谢" : "Credits"}
      </a>
      <a href="https://github.com/daydrift-studio/daydrift" class="nav-item github-link" target="_blank" rel="noopener" aria-label="GitHub 发行仓">
        GitHub
      </a>
    </nav>
  </div>
</header>

<script>
  function setupNavigationInteractivity() {
    const bar = document.getElementById("site-progress-bar");
    if (!bar) return;

    // Reset bar state
    bar.className = "";
    bar.style.width = "0%";
    bar.style.opacity = "0";

    // Handle seamless ecosystem click feedback
    document.addEventListener("click", (e) => {
      const target = (e.target as HTMLElement)?.closest("a");
      if (!target || !target.href) return;
      if (target.target === "_blank") return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      try {
        const url = new URL(target.href, window.location.href);
        const isEcosystem = url.hostname === window.location.hostname || url.hostname.endsWith(".blym.top");
        if (isEcosystem && url.href !== window.location.href) {
          bar.className = "loading";
        }
      } catch {
        // ignore invalid URL
      }
    });

    window.addEventListener("beforeunload", () => {
      if (bar) bar.className = "loading";
    });
  }

  setupNavigationInteractivity();
  document.addEventListener("astro:page-load", setupNavigationInteractivity);
</script>

<style>
  .site-header {
    height: var(--header-height);
    background-color: rgba(15, 16, 19, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .header-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    align-items: center;
    transition: transform 0.15s ease;
  }

  .brand-link:hover {
    transform: scale(1.02);
  }

  .brand-badge {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .brand-logo-img {
    vertical-align: middle;
    filter: drop-shadow(0 2px 4px rgba(229, 154, 76, 0.2));
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-main);
  }

  .brand-sub {
    font-size: 0.75rem;
    color: var(--accent-amber);
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-item {
    position: relative;
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.92rem;
    font-weight: 500;
    padding: 0.35rem 0.5rem;
    border-radius: 4px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-item:hover {
    color: var(--text-main);
    background-color: rgba(255, 255, 255, 0.04);
  }

  .nav-item.active {
    color: var(--accent-amber);
    font-weight: 600;
  }

  .nav-item.active::after {
    content: "";
    position: absolute;
    bottom: -8px;
    left: 0.5rem;
    right: 0.5rem;
    height: 2px;
    background-color: var(--accent-amber);
    box-shadow: 0 0 8px rgba(229, 154, 76, 0.6);
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    font-size: 0.85rem;
  }

  .github-link:hover {
    border-color: var(--border-accent);
    color: var(--accent-amber);
  }

  @media (max-width: 640px) {
    .nav-links {
      gap: 0.5rem;
    }
    .brand-sub {
      display: none;
    }
  }
</style>
